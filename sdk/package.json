{
  "name": "vishlex",
  "version": "0.1.7",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types":   "./dist/index.d.ts",
      "import":  "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./next": {
      "react-server": "./dist/next-server.mjs",
      "types":         "./dist/next.d.ts",
      "import":        "./dist/next.js",
      "require":       "./dist/next.cjs"
    }
  },
  "files": [
    "dist",
    "next.js",
    "next.d.ts",
    "package.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev":   "tsup --watch",
    "clean": "rm -rf dist"
  },
  "keywords": ["analytics", "nextjs", "privacy", "vishlex"],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "react":     ">=18",
    "react-dom": ">=18",
    "next":      ">=14"
  },
  "devDependencies": {
    "@types/node":      "^25.5.0",
    "@types/react":     "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "next":             ">=14",
    "tsup":             "^8.5.1",
    "typescript":       "^5.9.3"
  }
}